{
  "name": "brembo-flight",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Un simulatore di drone 3D gratuito e open source, con una valle alpina dimostrativa.",
  "license": "AGPL-3.0-only",
  "repository": "github:davideforci7-lgtm/Brembo-flight",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run test:e2e",
    "playtest": "npm run build && node scripts/playtest.mjs",
    "package:playtest": "npm run build && node scripts/package-playtest.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
